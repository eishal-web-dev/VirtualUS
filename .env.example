# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/virtualus?schema=public"

# --- Telecom ----------------------------------------------------------
# Default is the free Ashes-to-Ashes network; no carrier variables are needed.
# Businesses connect their own Telnyx/Twilio credentials inside Settings.
# Shared platform credentials are disabled unless this is explicitly true.
ALLOW_PLATFORM_CARRIER="false"
TELECOM_PROVIDER="demo"
# Optional legacy platform key. Ignored while ALLOW_PLATFORM_CARRIER=false.
TELNYX_API_KEY=""
TELNYX_PUBLIC_KEY=""

# --- Optional legacy platform Twilio fallback -------------------------
# Ignored while ALLOW_PLATFORM_CARRIER=false. Prefer customer-owned credentials.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_TWIML_APP_SID=""

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- App ------------------------------------------------------------------
# Public base URL carrier/provider webhooks should call back to.
APP_BASE_URL="http://localhost:3000"

# --- Meta (WhatsApp Cloud API, Facebook Messenger, Instagram) -------------
# Meta App Dashboard > Settings > Basic
META_APP_ID=""
META_APP_SECRET=""
# Any string you choose; must match the "Verify Token" set in the Meta
# webhook configuration for each product (WhatsApp/Messenger/Instagram).
META_VERIFY_TOKEN=""

# Meta Business Suite > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- TikTok Business Messaging (requires TikTok API approval) -------------
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- X / Twitter (requires a paid API tier with DM access) ----------------
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- Shopify ---------------------------------------------------------------
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# --- Credential encryption -------------------------------------------------
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
# Used to encrypt stored OAuth tokens/credentials for every integration.
ENCRYPTION_KEY=""
