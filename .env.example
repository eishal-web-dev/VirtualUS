# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/virtualus?schema=public"

# --- Telecom ----------------------------------------------------------
# Default is the free Ashes-to-Ashes demo network.
ALLOW_PLATFORM_CARRIER="false"
TELECOM_PROVIDER="demo"

# Recommended $0 development carrier: Plivo free trial.
# Either connect these credentials in Ashes Settings, or set them here and
# explicitly enable ALLOW_PLATFORM_CARRIER=true + TELECOM_PROVIDER=plivo.
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""

# Optional Telnyx platform fallback. Use only when intentionally selected.
TELNYX_API_KEY=""
TELNYX_PUBLIC_KEY=""

# Optional legacy platform Twilio fallback.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_TWIML_APP_SID=""

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- App ------------------------------------------------------------------
# Public base URL carrier/provider webhooks should call back to.
APP_BASE_URL="http://localhost:3000"

# --- Meta (WhatsApp Cloud API, Facebook Messenger, Instagram) -------------
# Direct Meta is the default WhatsApp path. Set WHATSAPP_TRANSPORT=telnyx only
# if you deliberately want Telnyx to manage WhatsApp.
WHATSAPP_TRANSPORT="meta"
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- TikTok Business Messaging (requires TikTok API approval) -------------
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- X / Twitter (requires a paid API tier with DM access) ----------------
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- Shopify ---------------------------------------------------------------
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# --- Credential encryption -------------------------------------------------
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
