// Prisma schema for Ashes Connect (evolved from VirtualUS Phase 1)
// Run `npm run prisma:generate` after editing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhoneNumberStatus {
  ACTIVE
  RELEASED
  PENDING
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  FAILED
  NO_ANSWER
  CANCELED
}

enum SubscriptionPlan {
  STARTER
  BUSINESS
  COMMERCE
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum BusinessRole {
  OWNER
  ADMIN
  AGENT
}

enum Channel {
  PHONE
  SMS
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TWITTER
  SHOPIFY
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  CALL_EVENT
  ORDER_EVENT
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum IntegrationProvider {
  TWILIO
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TWITTER
  SHOPIFY
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  PENDING_APPROVAL
  MOCK
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum NotificationType {
  CALL
  MESSAGE
  SYSTEM
}

model User {
  id              String   @id @default(cuid())
  name            String?
  email           String   @unique
  passwordHash    String
  businessName    String?
  country         String   @default("US")
  timezone        String   @default("America/Chicago")
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phoneNumbers PhoneNumber[]
  calls        Call[]

  memberships           BusinessMember[]
  assignedConversations Conversation[]   @relation("ConversationAssignee")
  assignedCustomers     Customer[]       @relation("CustomerAssignee")
  sentMessages          Message[]        @relation("MessageSender")
  notifications         Notification[]

  @@map("users")
}

model PhoneNumber {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  number      String            @unique
  provider    String            @default("twilio")
  providerSid String            @unique
  areaCode    String
  status      PhoneNumberStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())

  calls Call[]

  @@map("phone_numbers")
}

model Call {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String?
  business        Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  phoneNumberId   String?
  phoneNumber     PhoneNumber?  @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  providerCallSid String?       @unique
  direction       CallDirection
  from            String
  to              String
  status          CallStatus    @default(QUEUED)
  duration        Int           @default(0)
  cost            Decimal?      @db.Decimal(10, 4)
  recordingUrl    String?
  notes           String?
  createdAt       DateTime      @default(now())
  endedAt         DateTime?

  @@index([userId])
  @@index([businessId])
  @@index([customerId])
  @@map("calls")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            BusinessMember[]
  phoneNumbers       PhoneNumber[]
  calls              Call[]
  customers          Customer[]
  customerIdentities CustomerIdentity[]
  conversations      Conversation[]
  integrations       Integration[]
  shopifyStore        ShopifyStore?
  subscription        Subscription?
  webhookEvents       WebhookEvent[]
  notifications       Notification[]

  @@map("businesses")
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(AGENT)
  createdAt  DateTime     @default(now())

  @@unique([businessId, userId])
  @@map("business_members")
}

model Subscription {
  id          String             @id @default(cuid())
  businessId  String             @unique
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @default(STARTER)
  status      SubscriptionStatus @default(TRIALING)
  renewalDate DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("subscriptions")
}

model Customer {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String?
  email           String?
  phone           String?
  tags            String[] @default([])
  notes           String?
  assignedUserId  String?
  assignedUser    User?    @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  lastContactedAt DateTime?

  identities    CustomerIdentity[]
  conversations Conversation[]
  calls         Call[]
  shopifyLinks  ShopifyCustomer[]

  @@index([businessId])
  @@map("customers")
}

model CustomerIdentity {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   Channel
  externalId String
  username   String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())

  @@unique([businessId, platform, externalId])
  @@index([businessId])
  @@index([customerId])
  @@map("customer_identities")
}

model Conversation {
  id                     String             @id @default(cuid())
  businessId             String
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel                Channel
  externalConversationId String?
  assignedUserId         String?
  assignedUser           User?              @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  status                 ConversationStatus @default(OPEN)
  unreadCount            Int                @default(0)
  tags                   String[]           @default([])
  lastMessageAt          DateTime?
  createdAt              DateTime           @default(now())

  messages Message[]

  @@unique([businessId, customerId, channel])
  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId        String
  senderUserId      String?
  senderUser        User?            @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  channel           Channel
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  body              String?
  attachmentUrl     String?
  providerMessageId String?
  dedupeKey         String?          @unique
  status            MessageStatus    @default(QUEUED)
  sentAt            DateTime         @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([conversationId])
  @@index([customerId])
  @@map("messages")
}

model Integration {
  id                   String              @id @default(cuid())
  businessId           String
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider             IntegrationProvider
  status               IntegrationStatus   @default(NOT_CONNECTED)
  externalAccountId    String?
  externalAccountName  String?
  routingKey           String?             @unique
  encryptedCredentials String?
  config               Json?
  connectedAt          DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([businessId, provider])
  @@map("integrations")
}

model ShopifyStore {
  id                   String    @id @default(cuid())
  businessId           String    @unique
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopDomain           String    @unique
  accessTokenEncrypted String?
  connectedAt          DateTime?
  lastSyncAt           DateTime?

  shopifyCustomers ShopifyCustomer[]

  @@map("shopify_stores")
}

model ShopifyCustomer {
  id                String       @id @default(cuid())
  shopifyStoreId    String
  shopifyStore      ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shopifyCustomerId String
  email             String?
  phone             String?
  totalSpent        Decimal      @default(0) @db.Decimal(10, 2)
  ordersCount       Int          @default(0)

  orders ShopifyOrder[]

  @@unique([shopifyStoreId, shopifyCustomerId])
  @@index([customerId])
  @@map("shopify_customers")
}

model ShopifyOrder {
  id                String          @id @default(cuid())
  shopifyCustomerId String
  shopifyCustomer   ShopifyCustomer @relation(fields: [shopifyCustomerId], references: [id], onDelete: Cascade)
  shopifyOrderId    String
  orderNumber       String
  totalPrice        Decimal         @db.Decimal(10, 2)
  financialStatus   String?
  fulfillmentStatus String?
  createdAt         DateTime        @default(now())

  @@unique([shopifyCustomerId, shopifyOrderId])
  @@map("shopify_orders")
}

model WebhookEvent {
  id          String        @id @default(cuid())
  businessId  String?
  business    Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  provider    String
  eventId     String?
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  receivedAt  DateTime      @default(now())
  processedAt DateTime?
  error       String?

  @@index([businessId])
  @@index([provider])
  @@map("webhook_events")
}

model Notification {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String?
  channel        Channel?
  conversationId String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([businessId])
  @@index([userId])
  @@map("notifications")
}
